# Database Configuration (SQL Only - PostgreSQL for Docker/Production, SQLite for Zero-Setup Local Dev)
DATABASE_URL=sqlite:///./airindex.db
# For PostgreSQL: postgresql://airindex_user:airindex_secure_password_2026@localhost:5432/airindex_db

# JWT Security
JWT_SECRET_KEY=airindex_super_secret_production_key_change_in_prod_2026_x98!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth 2.0 Credentials (Optional - Mock credentials supported for local testing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# SMTP Email Configuration (Optional - Local mock dispatch falls back gracefully)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@airindex.in
SMTP_TLS=True

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# OTP Settings
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
